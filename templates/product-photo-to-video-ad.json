              "name": "video_url",
              "value": "={{ $json.video.url }}",
              "type": "string"
            },
            {
              "id": "b941d3d0-0da1-5331-b381-b0e0323bb422",
              "name": "image_url",
              "value": "={{ $('Lifestyle shot (Nano Banana Pro Edit)').item.json.data[0].url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ff9350d7-a30b-5030-b079-b12ff49f10f0",
      "name": "Ad links",
