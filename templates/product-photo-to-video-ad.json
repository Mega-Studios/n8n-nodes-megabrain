        "url": "https://getmegabrain.com/api/gateway/v1/images/generations",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'nano-banana-pro/edit', prompt: $json.image_prompt, image_urls: [ $('Product form').item.json['Product photo URL'] ], aspect_ratio: '9:16', resolution: '1K' }) }}",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
